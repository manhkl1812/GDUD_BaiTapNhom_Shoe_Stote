</li>
<li data-start="1425" data-end="1432">
<p data-start="1427" data-end="1432">Mô tả</p>
</li>
</ul>
</li>
<li data-start="1433" data-end="1447">
<p data-start="1435" data-end="1447">Sửa sản phẩm</p>
</li>
<li data-start="1448" data-end="1467">
<p data-start="1450" data-end="1467">Xóa / Ẩn sản phẩm</p>
</li>
<li data-start="1468" data-end="1485">
<p data-start="1470" data-end="1485">Quản lý tồn kho</p>
</li>
</ul>
<h3 data-start="1487" data-end="1497">Ví dụ:</h3>
<ul data-start="1498" data-end="1571">
<li data-start="1498" data-end="1571">
<p data-start="1500" data-end="1515">Nike Air Jordan</p>
<ul data-start="1518" data-end="1571">
<li data-start="1518" data-end="1535">
