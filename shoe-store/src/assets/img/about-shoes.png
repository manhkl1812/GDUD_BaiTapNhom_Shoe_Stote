          </span><span><span class="hljs-attr">position:</span></span><span> "</span><span><span class="hljs-attr">relative</span></span><span>",
          </span><span><span class="hljs-attr">display:</span></span><span> "</span><span><span class="hljs-attr">inline-block</span></span><span>",
        }}
      &gt;
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">img</span></span></span><span>
          </span><span><span class="hljs-attr">src</span></span><span>=</span><span><span class="hljs-string">{cartIcon}</span></span><span>
          </span><span><span class="hljs-attr">alt</span></span><span>=</span><span><span class="hljs-string">"cart"</span></span><span>
          </span><span><span class="hljs-attr">style</span></span><span>=</span><span><span class="hljs-string">{{</span></span><span> </span><span><span class="hljs-attr">width:</span></span><span> </span><span><span class="hljs-attr">40</span></span><span>, </span><span><span class="hljs-attr">height:</span></span><span> </span><span><span class="hljs-attr">40</span></span><span> }}
        /&gt;

        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Popup</span></span></span><span> </span><span><span class="hljs-attr">count</span></span><span>=</span><span><span class="hljs-string">{count}</span></span><span> /&gt;
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;

      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">br</span></span></span><span> /&gt;</span><span><span class="hljs-tag">&lt;<span class="hljs-name">br</span></span></span><span> /&gt;

