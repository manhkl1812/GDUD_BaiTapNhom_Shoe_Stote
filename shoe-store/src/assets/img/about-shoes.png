</span><span><span class="hljs-keyword">const</span></span><span> </span><span><span class="hljs-title function_">About</span></span><span> = (</span><span><span class="hljs-params"></span></span><span>) =&gt; {
  </span><span><span class="hljs-keyword">return</span></span><span> (
    </span><span><span class="language-xml"><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span></span><span> </span><span><span class="hljs-attr">style</span></span><span>=</span><span><span class="hljs-string">{{</span></span><span> </span><span><span class="hljs-attr">padding:</span></span><span> "</span><span><span class="hljs-attr">40px</span></span><span>" }}&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h2</span></span></span><span>&gt;Về Chúng Tôi</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h2</span></span></span><span>&gt;

      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">img</span></span></span><span>
        </span><span><span class="hljs-attr">src</span></span><span>=</span><span><span class="hljs-string">{aboutImg}</span></span><span>
        </span><span><span class="hljs-attr">alt</span></span><span>=</span><span><span class="hljs-string">"about"</span></span><span>
        </span><span><span class="hljs-attr">style</span></span><span>=</span><span><span class="hljs-string">{{</span></span><span> </span><span><span class="hljs-attr">width:</span></span><span> "</span><span><span class="hljs-attr">100</span></span><span>%", </span><span><span class="hljs-attr">maxWidth:</span></span><span> "</span><span><span class="hljs-attr">600px</span></span><span>", </span><span><span class="hljs-attr">margin:</span></span><span> "</span><span><span class="hljs-attr">20px</span></span><span> </span><span><span class="hljs-attr">0</span></span><span>" }}
      /&gt;

      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span>&gt;
        Shoe Store là cửa hàng chuyên cung cấp các sản phẩm giày chất lượng cao,
        thiết kế hiện đại và phù hợp với xu hướng thời trang mới nhất.
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;

      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span>&gt;
        Chúng tôi cam kết mang đến trải nghiệm mua sắm tốt nhất cho khách hàng
        với dịch vụ tận tâm và sản phẩm chính hãng.
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
  );
};

</span><span><span class="hljs-keyword">export</span></span><span> </span><span><span class="hljs-keyword">default</span></span><span> </span><span><span class="hljs-title class_">About</span></span><span>;
</span></span></code></div></div></pre>
<hr data-start="2560" data-end="2563">
<h1 data-start="2565" data-end="2598">📌 Ví dụ cách dùng trong Detail</h1>
<pre class="overflow-visible! px-0!" data-start="2600" data-end="3233"><div class="contain-inline-size rounded-2xl corner-superellipse/1.1 relative bg-token-sidebar-surface-primary"><div class="flex items-center text-token-text-secondary px-4 py-2 text-xs font-sans justify-between h-9 bg-token-sidebar-surface-primary select-none rounded-t-2xl corner-t-superellipse/1.1">jsx</div><div class="sticky top-[calc(var(--sticky-padding-top)+9*var(--spacing))]"><div class="absolute end-0 bottom-0 flex h-9 items-center pe-2"><div class="bg-token-bg-elevated-secondary text-token-text-secondary flex items-center gap-4 rounded-sm px-2 font-sans text-xs"><button class="flex gap-1 items-center select-none py-1" aria-label="Sao chép"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-sm"><use href="/cdn/assets/sprites-core-j9921kii.svg#ce3544" fill="currentColor"></use></svg>Sao chép mã</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-jsx"><span><span><span class="hljs-keyword">import</span></span><span> { useState } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"react"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">SizeSelector</span></span><span> </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"../../components/product/SizeSelector"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">QuantitySelector</span></span><span> </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"../../components/product/QuantitySelector"</span></span><span>;

</span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">ProductDetail</span></span><span>(</span><span><span class="hljs-params"></span></span><span>) {
  </span><span><span class="hljs-keyword">const</span></span><span> [size, setSize] = </span><span><span class="hljs-title function_">useState</span></span><span>(</span><span><span class="hljs-literal">null</span></span><span>);
  </span><span><span class="hljs-keyword">const</span></span><span> [quantity, setQuantity] = </span><span><span class="hljs-title function_">useState</span></span><span>(</span><span><span class="hljs-number">1</span></span><span>);

  </span><span><span class="hljs-keyword">return</span></span><span> (
    </span><span><span class="language-xml"><span class="hljs-tag">&lt;&gt;</span></span></span><span>
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">SizeSelector</span></span></span><span>
        </span><span><span class="hljs-attr">sizes</span></span><span>=</span><span><span class="hljs-string">{[38,</span></span><span> </span><span><span class="hljs-attr">39</span></span><span>, </span><span><span class="hljs-attr">40</span></span><span>, </span><span><span class="hljs-attr">41</span></span><span>]}
        </span><span><span class="hljs-attr">selectedSize</span></span><span>=</span><span><span class="hljs-string">{size}</span></span><span>
        </span><span><span class="hljs-attr">onChange</span></span><span>=</span><span><span class="hljs-string">{setSize}</span></span><span>
      /&gt;

      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">QuantitySelector</span></span></span><span>
        </span><span><span class="hljs-attr">value</span></span><span>=</span><span><span class="hljs-string">{quantity}</span></span><span>
        </span><span><span class="hljs-attr">onIncrease</span></span><span>=</span><span><span class="hljs-string">{()</span></span><span> =&gt; setQuantity(quantity + 1)}
        onDecrease={() =&gt; quantity &gt; 1 &amp;&amp; setQuantity(quantity - 1)}
      /&gt;
    </span><span><span class="hljs-tag">&lt;/&gt;</span></span><span>
  );
}
</span></span></code></div></div></pre>
<hr data-start="3235" data-end="3238">
<h1 data-start="3240" data-end="3260">🔥 Điểm cộng đồ án</h1>
