  </span><span><span class="hljs-keyword">const</span></span><span> [openPopup, setOpenPopup] = </span><span><span class="hljs-title function_">useState</span></span><span>(</span><span><span class="hljs-literal">false</span></span><span>);
  </span><span><span class="hljs-keyword">const</span></span><span> [rating, setRating] = </span><span><span class="hljs-title function_">useState</span></span><span>(</span><span><span class="hljs-number">0</span></span><span>);

