<h2 data-start="1843" data-end="1874"><code data-start="1846" data-end="1874">components/ProductCard.jsx</code></h2>
<pre class="overflow-visible! px-0!" data-start="1875" data-end="2428"><div class="contain-inline-size rounded-2xl corner-superellipse/1.1 relative bg-token-sidebar-surface-primary"><div class="flex items-center text-token-text-secondary px-4 py-2 text-xs font-sans justify-between h-9 bg-token-sidebar-surface-primary select-none rounded-t-2xl corner-t-superellipse/1.1">jsx</div><div class="sticky top-[calc(var(--sticky-padding-top)+9*var(--spacing))]"><div class="absolute end-0 bottom-0 flex h-9 items-center pe-2"><div class="bg-token-bg-elevated-secondary text-token-text-secondary flex items-center gap-4 rounded-sm px-2 font-sans text-xs"><button class="flex gap-1 items-center select-none py-1" aria-label="Sao chép"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-sm"><use href="/cdn/assets/sprites-core-j9921kii.svg#ce3544" fill="currentColor"></use></svg>Sao chép mã</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-jsx"><span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">ProductCard</span></span><span>(</span><span><span class="hljs-params">{ shoe, addToCart }</span></span><span>) {
  </span><span><span class="hljs-keyword">return</span></span><span> (
    </span><span><span class="language-xml"><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"col-md-4 mb-4"</span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"card h-100 shadow"</span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"card-body"</span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h5</span></span></span><span>&gt;{shoe.name}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h5</span></span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-danger fw-bold"</span></span><span>&gt;
            {shoe.price.toLocaleString()} ₫
          </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">button</span></span></span><span>
            </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"btn btn-primary w-100"</span></span><span>
            </span><span><span class="hljs-attr">onClick</span></span><span>=</span><span><span class="hljs-string">{()</span></span><span> =&gt; addToCart(shoe)}
          &gt;
            Thêm vào giỏ
          </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">button</span></span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
  )
}

</span><span><span class="hljs-keyword">export</span></span><span> </span><span><span class="hljs-keyword">default</span></span><span> </span><span><span class="hljs-title class_">ProductCard</span></span><span>
</span></span></code></div></div></pre>
<hr data-start="2430" data-end="2433">
<h1 data-start="2435" data-end="2464">✅ 3️⃣ XÓA SẢN PHẨM KHỎI GIỎ</h1>
<h2 data-start="2466" data-end="2485"><code data-start="2469" data-end="2485">pages/Cart.jsx</code></h2>
<pre class="overflow-visible! px-0!" data-start="2486" data-end="3167"><div class="contain-inline-size rounded-2xl corner-superellipse/1.1 relative bg-token-sidebar-surface-primary"><div class="flex items-center text-token-text-secondary px-4 py-2 text-xs font-sans justify-between h-9 bg-token-sidebar-surface-primary select-none rounded-t-2xl corner-t-superellipse/1.1">jsx</div><div class="sticky top-[calc(var(--sticky-padding-top)+9*var(--spacing))]"><div class="absolute end-0 bottom-0 flex h-9 items-center pe-2"><div class="bg-token-bg-elevated-secondary text-token-text-secondary flex items-center gap-4 rounded-sm px-2 font-sans text-xs"><button class="flex gap-1 items-center select-none py-1" aria-label="Sao chép"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-sm"><use href="/cdn/assets/sprites-core-j9921kii.svg#ce3544" fill="currentColor"></use></svg>Sao chép mã</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-jsx"><span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">Cart</span></span><span>(</span><span><span class="hljs-params">{ cart, removeFromCart, total }</span></span><span>) {
  </span><span><span class="hljs-keyword">return</span></span><span> (
    </span><span><span class="language-xml"><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"container mt-4"</span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h2</span></span></span><span>&gt;🛒 Giỏ hàng</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h2</span></span></span><span>&gt;

      {cart.length === 0 &amp;&amp; </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span>&gt;Giỏ hàng trống</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;}

      {cart.map(item =&gt; (
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span>
          </span><span><span class="hljs-attr">key</span></span><span>=</span><span><span class="hljs-string">{item.id}</span></span><span>
          </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"d-flex justify-content-between border-bottom py-2"</span></span><span>
        &gt;
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">span</span></span></span><span>&gt;{item.name}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">span</span></span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">button</span></span></span><span>
            </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"btn btn-sm btn-danger"</span></span><span>
            </span><span><span class="hljs-attr">onClick</span></span><span>=</span><span><span class="hljs-string">{()</span></span><span> =&gt; removeFromCart(item.id)}
          &gt;
            Xóa
          </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">button</span></span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
      ))}

      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h4</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-3"</span></span><span>&gt;
        Tổng tiền: {total.toLocaleString()} ₫
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h4</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
  )
}

</span><span><span class="hljs-keyword">export</span></span><span> </span><span><span class="hljs-keyword">default</span></span><span> </span><span><span class="hljs-title class_">Cart</span></span><span>
</span></span></code></div></div></pre>
<hr data-start="3169" data-end="3172">
<h1 data-start="3174" data-end="3209">✅ 4️⃣ LƯU GIỎ HÀNG (LOCALSTORAGE)</h1>
<p data-start="3211" data-end="3237">📌 Đã làm trong <code data-start="3227" data-end="3236">App.jsx</code>:</p>
<pre class="overflow-visible! px-0!" data-start="3238" data-end="3330"><div class="contain-inline-size rounded-2xl corner-superellipse/1.1 relative bg-token-sidebar-surface-primary"><div class="flex items-center text-token-text-secondary px-4 py-2 text-xs font-sans justify-between h-9 bg-token-sidebar-surface-primary select-none rounded-t-2xl corner-t-superellipse/1.1">jsx</div><div class="sticky top-[calc(var(--sticky-padding-top)+9*var(--spacing))]"><div class="absolute end-0 bottom-0 flex h-9 items-center pe-2"><div class="bg-token-bg-elevated-secondary text-token-text-secondary flex items-center gap-4 rounded-sm px-2 font-sans text-xs"><button class="flex gap-1 items-center select-none py-1" aria-label="Sao chép"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-sm"><use href="/cdn/assets/sprites-core-j9921kii.svg#ce3544" fill="currentColor"></use></svg>Sao chép mã</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-jsx"><span><span><span class="hljs-title function_">useEffect</span></span><span>(</span><span><span class="hljs-function">() =&gt;</span></span><span> {
  </span><span><span class="hljs-variable language_">localStorage</span></span><span>.</span><span><span class="hljs-title function_">setItem</span></span><span>(</span><span><span class="hljs-string">"cart"</span></span><span>, </span><span><span class="hljs-title class_">JSON</span></span><span>.</span><span><span class="hljs-title function_">stringify</span></span><span>(cart))
}, [cart])
</span></span></code></div></div></pre>
<p data-start="3332" data-end="3369">✔ Reload trang <strong data-start="3347" data-end="3369">KHÔNG mất giỏ hàng</strong></p>
