<h1 data-start="577" data-end="612">🧩 COMPONENT BADGE + ICON (React)</h1>
<h3 data-start="614" data-end="633">📁 Vị trí chuẩn</h3>
<pre class="overflow-visible! px-0!" data-start="634" data-end="680"><div class="contain-inline-size rounded-2xl corner-superellipse/1.1 relative bg-token-sidebar-surface-primary"><div class="flex items-center text-token-text-secondary px-4 py-2 text-xs font-sans justify-between h-9 bg-token-sidebar-surface-primary select-none rounded-t-2xl corner-t-superellipse/1.1">text</div><div class="sticky top-[calc(var(--sticky-padding-top)+9*var(--spacing))]"><div class="absolute end-0 bottom-0 flex h-9 items-center pe-2"><div class="bg-token-bg-elevated-secondary text-token-text-secondary flex items-center gap-4 rounded-sm px-2 font-sans text-xs"><button class="flex gap-1 items-center select-none py-1" aria-label="Sao chép"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-sm"><use href="/cdn/assets/sprites-core-j9921kii.svg#ce3544" fill="currentColor"></use></svg>Sao chép mã</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-text"><span><span>src/components/common/CartIcon.jsx
</span></span></code></div></div></pre>
<h3 data-start="682" data-end="693">📄 Code</h3>
<pre class="overflow-visible! px-0!" data-start="694" data-end="1243"><div class="contain-inline-size rounded-2xl corner-superellipse/1.1 relative bg-token-sidebar-surface-primary"><div class="flex items-center text-token-text-secondary px-4 py-2 text-xs font-sans justify-between h-9 bg-token-sidebar-surface-primary select-none rounded-t-2xl corner-t-superellipse/1.1">jsx</div><div class="sticky top-[calc(var(--sticky-padding-top)+9*var(--spacing))]"><div class="absolute end-0 bottom-0 flex h-9 items-center pe-2"><div class="bg-token-bg-elevated-secondary text-token-text-secondary flex items-center gap-4 rounded-sm px-2 font-sans text-xs"><button class="flex gap-1 items-center select-none py-1" aria-label="Sao chép"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-sm"><use href="/cdn/assets/sprites-core-j9921kii.svg#ce3544" fill="currentColor"></use></svg>Sao chép mã</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-jsx"><span><span><span class="hljs-keyword">const</span></span><span> </span><span><span class="hljs-title function_">CartIcon</span></span><span> = (</span><span><span class="hljs-params">{ count }</span></span><span>) =&gt; {
  </span><span><span class="hljs-keyword">return</span></span><span> (
    </span><span><span class="language-xml"><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span></span><span> </span><span><span class="hljs-attr">style</span></span><span>=</span><span><span class="hljs-string">{{</span></span><span> </span><span><span class="hljs-attr">position:</span></span><span> "</span><span><span class="hljs-attr">relative</span></span><span>", </span><span><span class="hljs-attr">fontSize:</span></span><span> </span><span><span class="hljs-attr">28</span></span><span> }}&gt;
      🛒

      {count &gt; 0 &amp;&amp; (
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">span</span></span></span><span>
          </span><span><span class="hljs-attr">style</span></span><span>=</span><span><span class="hljs-string">{{</span></span><span>
            </span><span><span class="hljs-attr">position:</span></span><span> "</span><span><span class="hljs-attr">absolute</span></span><span>",
            </span><span><span class="hljs-attr">top:</span></span><span> </span><span><span class="hljs-attr">-6</span></span><span>,
            </span><span><span class="hljs-attr">right:</span></span><span> </span><span><span class="hljs-attr">-10</span></span><span>,
            </span><span><span class="hljs-attr">background:</span></span><span> "</span><span><span class="hljs-attr">red</span></span><span>",
            </span><span><span class="hljs-attr">color:</span></span><span> "</span><span><span class="hljs-attr">white</span></span><span>",
            </span><span><span class="hljs-attr">borderRadius:</span></span><span> "</span><span><span class="hljs-attr">50</span></span><span>%",
            </span><span><span class="hljs-attr">padding:</span></span><span> "</span><span><span class="hljs-attr">2px</span></span><span> </span><span><span class="hljs-attr">6px</span></span><span>",
            </span><span><span class="hljs-attr">fontSize:</span></span><span> </span><span><span class="hljs-attr">12</span></span><span>,
            </span><span><span class="hljs-attr">fontWeight:</span></span><span> "</span><span><span class="hljs-attr">bold</span></span><span>",
          }}
        &gt;
          {count}
        </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">span</span></span></span><span>&gt;
      )}
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
  );
};

</span><span><span class="hljs-keyword">export</span></span><span> </span><span><span class="hljs-keyword">default</span></span><span> </span><span><span class="hljs-title class_">CartIcon</span></span><span>;
</span></span></code></div></div></pre>
<hr data-start="1245" data-end="1248">
<h1 data-start="1250" data-end="1280">🧪 CÁCH DÙNG TRONG <code data-start="1271" data-end="1280">App.jsx</code></h1>
<pre class="overflow-visible! px-0!" data-start="1282" data-end="1615"><div class="contain-inline-size rounded-2xl corner-superellipse/1.1 relative bg-token-sidebar-surface-primary"><div class="flex items-center text-token-text-secondary px-4 py-2 text-xs font-sans justify-between h-9 bg-token-sidebar-surface-primary select-none rounded-t-2xl corner-t-superellipse/1.1">jsx</div><div class="sticky top-[calc(var(--sticky-padding-top)+9*var(--spacing))]"><div class="absolute end-0 bottom-0 flex h-9 items-center pe-2"><div class="bg-token-bg-elevated-secondary text-token-text-secondary flex items-center gap-4 rounded-sm px-2 font-sans text-xs"><button class="flex gap-1 items-center select-none py-1" aria-label="Sao chép"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-sm"><use href="/cdn/assets/sprites-core-j9921kii.svg#ce3544" fill="currentColor"></use></svg>Sao chép mã</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-jsx"><span><span><span class="hljs-keyword">import</span></span><span> { useState } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"react"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">CartIcon</span></span><span> </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"./components/common/CartIcon"</span></span><span>;

</span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">App</span></span><span>(</span><span><span class="hljs-params"></span></span><span>) {
  </span><span><span class="hljs-keyword">const</span></span><span> [count, setCount] = </span><span><span class="hljs-title function_">useState</span></span><span>(</span><span><span class="hljs-number">0</span></span><span>);

  </span><span><span class="hljs-keyword">return</span></span><span> (
    </span><span><span class="language-xml"><span class="hljs-tag">&lt;&gt;</span></span></span><span>
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">CartIcon</span></span></span><span> </span><span><span class="hljs-attr">count</span></span><span>=</span><span><span class="hljs-string">{count}</span></span><span> /&gt;

      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">button</span></span></span><span> </span><span><span class="hljs-attr">onClick</span></span><span>=</span><span><span class="hljs-string">{()</span></span><span> =&gt; setCount(count + 1)}&gt;
        Thêm vào giỏ
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">button</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;/&gt;</span></span><span>
  );
}

</span><span><span class="hljs-keyword">export</span></span><span> </span><span><span class="hljs-keyword">default</span></span><span> </span><span><span class="hljs-title class_">App</span></span><span>;
</span></span></code></div></div></pre>
<p data-start="1617" data-end="1649">👉 Mỗi lần bấm <strong data-start="1632" data-end="1648">Thêm vào giỏ</strong>:</p>
<ul data-start="1650" data-end="1689">
<li data-start="1650" data-end="1673">
<p data-start="1652" data-end="1673">Số trên icon tăng lên</p>
</li>
<li data-start="1674" data-end="1689">
<p data-start="1676" data-end="1689">Badge tự hiện</p>
</li>
</ul>
<hr data-start="1691" data-end="1694">
