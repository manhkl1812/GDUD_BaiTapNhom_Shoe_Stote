    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Route</span></span></span><span> </span><span><span class="hljs-attr">path</span></span><span>=</span><span><span class="hljs-string">"/cart"</span></span><span> </span><span><span class="hljs-attr">element</span></span><span>=</span><span><span class="hljs-string">{</span></span><span>&lt;</span><span><span class="hljs-attr">Cart</span></span><span> /&gt;} /&gt;
