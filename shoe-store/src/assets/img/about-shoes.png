      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">style</span></span><span>=</span><span><span class="hljs-string">{{</span></span><span> </span><span><span class="hljs-attr">position:</span></span><span> "</span><span><span class="hljs-attr">relative</span></span><span>", </span><span><span class="hljs-attr">display:</span></span><span> "</span><span><span class="hljs-attr">inline-block</span></span><span>" }}&gt;
