  </span><span><span class="hljs-keyword">const</span></span><span> [rating, setRating] = </span><span><span class="hljs-title function_">useState</span></span><span>(</span><span><span class="hljs-number">0</span></span><span>);

  </span><span><span class="hljs-keyword">return</span></span><span> (
    </span><span><span class="language-xml"><span class="hljs-tag">&lt;&gt;</span></span></span><span>
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Rating</span></span></span><span> </span><span><span class="hljs-attr">onChange</span></span><span>=</span><span><span class="hljs-string">{setRating}</span></span><span> /&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span>&gt;Điểm đánh giá: {rating} sao</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;/&gt;</span></span><span>
  );
}
