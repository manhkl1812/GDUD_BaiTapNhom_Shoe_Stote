<h2 data-start="297" data-end="332">📁 <code data-start="303" data-end="332">components/common/Popup.jsx</code></h2>
<blockquote data-start="333" data-end="395">
<p data-start="335" data-end="395">(thực chất đây là <strong data-start="353" data-end="362">Badge</strong>, nhưng bạn đặt tên Popup vẫn OK)</p>
</blockquote>
<pre class="overflow-visible! px-0!" data-start="397" data-end="814"><div class="contain-inline-size rounded-2xl corner-superellipse/1.1 relative bg-token-sidebar-surface-primary"><div class="flex items-center text-token-text-secondary px-4 py-2 text-xs font-sans justify-between h-9 bg-token-sidebar-surface-primary select-none rounded-t-2xl corner-t-superellipse/1.1">jsx</div><div class="sticky top-[calc(var(--sticky-padding-top)+9*var(--spacing))]"><div class="absolute end-0 bottom-0 flex h-9 items-center pe-2"><div class="bg-token-bg-elevated-secondary text-token-text-secondary flex items-center gap-4 rounded-sm px-2 font-sans text-xs"><button class="flex gap-1 items-center select-none py-1" aria-label="Sao chép"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-sm"><use href="/cdn/assets/sprites-core-j9921kii.svg#ce3544" fill="currentColor"></use></svg>Sao chép mã</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-jsx"><span><span><span class="hljs-keyword">const</span></span><span> </span><span><span class="hljs-title function_">Popup</span></span><span> = (</span><span><span class="hljs-params">{ count }</span></span><span>) =&gt; {
  </span><span><span class="hljs-keyword">if</span></span><span> (count &lt;= </span><span><span class="hljs-number">0</span></span><span>) </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-literal">null</span></span><span>;

  </span><span><span class="hljs-keyword">return</span></span><span> (
    </span><span><span class="language-xml"><span class="hljs-tag">&lt;<span class="hljs-name">span</span></span></span></span><span>
      </span><span><span class="hljs-attr">style</span></span><span>=</span><span><span class="hljs-string">{{</span></span><span>
        </span><span><span class="hljs-attr">position:</span></span><span> "</span><span><span class="hljs-attr">absolute</span></span><span>",
        </span><span><span class="hljs-attr">top:</span></span><span> "</span><span><span class="hljs-attr">-5px</span></span><span>",
        </span><span><span class="hljs-attr">right:</span></span><span> "</span><span><span class="hljs-attr">-5px</span></span><span>",
        </span><span><span class="hljs-attr">background:</span></span><span> "</span><span><span class="hljs-attr">red</span></span><span>",
        </span><span><span class="hljs-attr">color:</span></span><span> "</span><span><span class="hljs-attr">white</span></span><span>",
        </span><span><span class="hljs-attr">borderRadius:</span></span><span> "</span><span><span class="hljs-attr">50</span></span><span>%",
        </span><span><span class="hljs-attr">padding:</span></span><span> "</span><span><span class="hljs-attr">2px</span></span><span> </span><span><span class="hljs-attr">6px</span></span><span>",
        </span><span><span class="hljs-attr">fontSize:</span></span><span> "</span><span><span class="hljs-attr">12px</span></span><span>",
        </span><span><span class="hljs-attr">fontWeight:</span></span><span> "</span><span><span class="hljs-attr">bold</span></span><span>",
      }}
    &gt;
      {count}
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">span</span></span></span><span>&gt;
  );
};

</span><span><span class="hljs-keyword">export</span></span><span> </span><span><span class="hljs-keyword">default</span></span><span> </span><span><span class="hljs-title class_">Popup</span></span><span>;
</span></span></code></div></div></pre>
<hr data-start="816" data-end="819">
<h2 data-start="821" data-end="858">📌 Cách dùng (ví dụ icon giỏ hàng)</h2>
<pre class="overflow-visible! px-0!" data-start="860" data-end="1253"><div class="contain-inline-size rounded-2xl corner-superellipse/1.1 relative bg-token-sidebar-surface-primary"><div class="flex items-center text-token-text-secondary px-4 py-2 text-xs font-sans justify-between h-9 bg-token-sidebar-surface-primary select-none rounded-t-2xl corner-t-superellipse/1.1">jsx</div><div class="sticky top-[calc(var(--sticky-padding-top)+9*var(--spacing))]"><div class="absolute end-0 bottom-0 flex h-9 items-center pe-2"><div class="bg-token-bg-elevated-secondary text-token-text-secondary flex items-center gap-4 rounded-sm px-2 font-sans text-xs"><button class="flex gap-1 items-center select-none py-1" aria-label="Sao chép"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-sm"><use href="/cdn/assets/sprites-core-j9921kii.svg#ce3544" fill="currentColor"></use></svg>Sao chép mã</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-jsx"><span><span><span class="hljs-keyword">import</span></span><span> { useState } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"react"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">Popup</span></span><span> </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"./components/common/Popup"</span></span><span>;

</span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">CartIcon</span></span><span>(</span><span><span class="hljs-params"></span></span><span>) {
  </span><span><span class="hljs-keyword">const</span></span><span> [count, setCount] = </span><span><span class="hljs-title function_">useState</span></span><span>(</span><span><span class="hljs-number">1</span></span><span>);

  </span><span><span class="hljs-keyword">return</span></span><span> (
    </span><span><span class="language-xml"><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span></span><span> </span><span><span class="hljs-attr">style</span></span><span>=</span><span><span class="hljs-string">{{</span></span><span> </span><span><span class="hljs-attr">position:</span></span><span> "</span><span><span class="hljs-attr">relative</span></span><span>", </span><span><span class="hljs-attr">width:</span></span><span> </span><span><span class="hljs-attr">40</span></span><span> }}&gt;
      🛒
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Popup</span></span></span><span> </span><span><span class="hljs-attr">count</span></span><span>=</span><span><span class="hljs-string">{count}</span></span><span> /&gt;

      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">button</span></span></span><span> </span><span><span class="hljs-attr">onClick</span></span><span>=</span><span><span class="hljs-string">{()</span></span><span> =&gt; setCount(count + 1)}&gt;
        Thêm vào giỏ
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">button</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
  );
}

</span><span><span class="hljs-keyword">export</span></span><span> </span><span><span class="hljs-keyword">default</span></span><span> </span><span><span class="hljs-title class_">CartIcon</span></span><span>;
</span></span></code></div></div></pre>
<p data-start="1255" data-end="1269">👉 <strong data-start="1258" data-end="1269">Kết quả</strong></p>
<ul data-start="1270" data-end="1330">
<li data-start="1270" data-end="1300">
<p data-start="1272" data-end="1300">Khi <code data-start="1276" data-end="1287">count = 0</code> → không hiện</p>
</li>
<li data-start="1301" data-end="1330">
<p data-start="1303" data-end="1330">Khi tăng → badge hiện số 🔴</p>
</li>
</ul>
