</li>
<li data-start="964" data-end="982">
<p data-start="966" data-end="982">Trang thanh toán</p>
</li>
</ul>
<hr data-start="984" data-end="987">
<h3 data-start="989" data-end="1009">🔹 Button, Input</h3>
<ul data-start="1010" data-end="1151">
<li data-start="1010" data-end="1073">
<p data-start="1012" data-end="1023"><strong data-start="1012" data-end="1022">Button</strong>:</p>
<ul data-start="1026" data-end="1073">
<li data-start="1026" data-end="1045">
<p data-start="1028" data-end="1045">Thêm vào giỏ hàng</p>
</li>
<li data-start="1048" data-end="1058">
<p data-start="1050" data-end="1058">Mua ngay</p>
</li>
<li data-start="1061" data-end="1073">
<p data-start="1063" data-end="1073">Thanh toán</p>
</li>
</ul>
</li>
<li data-start="1074" data-end="1151">
<p data-start="1076" data-end="1086"><strong data-start="1076" data-end="1085">Input</strong>:</p>
<ul data-start="1089" data-end="1151">
<li data-start="1089" data-end="1104">
