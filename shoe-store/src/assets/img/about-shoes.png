<ul data-start="1641" data-end="1749">
<li data-start="1641" data-end="1671">
<p data-start="1643" data-end="1671">About nhìn giống Nike/Adidas</p>
</li>
<li data-start="1672" data-end="1696">
<p data-start="1674" data-end="1696">Có timeline phát triển</p>
</li>
