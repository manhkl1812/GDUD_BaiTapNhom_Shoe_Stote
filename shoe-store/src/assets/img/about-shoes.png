<li data-start="1515" data-end="1531">
<p data-start="1517" data-end="1531">Nhập thông tin</p>
</li>
<li data-start="1532" data-end="1554">
<p data-start="1534" data-end="1554">Nhận dữ liệu đầu vào</p>
</li>
</ul>
