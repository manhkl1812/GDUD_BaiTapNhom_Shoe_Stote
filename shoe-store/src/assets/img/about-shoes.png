<hr data-start="181" data-end="184">
<h2 data-start="186" data-end="228">✅ VỊ TRÍ “SÁT TRÊN ĐẦU ICON” (CHUẨN UI)</h2>
<h3 data-start="230" data-end="267">🔧 <code data-start="237" data-end="248">Popup.jsx</code> (CHỈ CẦN FILE NÀY)</h3>
<pre class="overflow-visible! px-0!" data-start="269" data-end="1377"><div class="contain-inline-size rounded-2xl corner-superellipse/1.1 relative bg-token-sidebar-surface-primary"><div class="flex items-center text-token-text-secondary px-4 py-2 text-xs font-sans justify-between h-9 bg-token-sidebar-surface-primary select-none rounded-t-2xl corner-t-superellipse/1.1">jsx</div><div class="sticky top-[calc(var(--sticky-padding-top)+9*var(--spacing))]"><div class="absolute end-0 bottom-0 flex h-9 items-center pe-2"><div class="bg-token-bg-elevated-secondary text-token-text-secondary flex items-center gap-4 rounded-sm px-2 font-sans text-xs"><button class="flex gap-1 items-center select-none py-1" aria-label="Sao chép"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-sm"><use href="/cdn/assets/sprites-core-j9921kii.svg#ce3544" fill="currentColor"></use></svg>Sao chép mã</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-jsx"><span><span><span class="hljs-keyword">import</span></span><span> { useState } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"react"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> cartIcon </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"../../assets/icon/shopping-cart.png"</span></span><span>;

</span><span><span class="hljs-keyword">const</span></span><span> </span><span><span class="hljs-title function_">Popup</span></span><span> = (</span><span><span class="hljs-params"></span></span><span>) =&gt; {
  </span><span><span class="hljs-keyword">const</span></span><span> [count, setCount] = </span><span><span class="hljs-title function_">useState</span></span><span>(</span><span><span class="hljs-number">1</span></span><span>);

  </span><span><span class="hljs-keyword">return</span></span><span> (
    </span><span><span class="language-xml"><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span></span><span> </span><span><span class="hljs-attr">style</span></span><span>=</span><span><span class="hljs-string">{{</span></span><span> </span><span><span class="hljs-attr">position:</span></span><span> "</span><span><span class="hljs-attr">relative</span></span><span>", </span><span><span class="hljs-attr">display:</span></span><span> "</span><span><span class="hljs-attr">inline-block</span></span><span>" }}&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">img</span></span></span><span> </span><span><span class="hljs-attr">src</span></span><span>=</span><span><span class="hljs-string">{cartIcon}</span></span><span> </span><span><span class="hljs-attr">width</span></span><span>=</span><span><span class="hljs-string">{40}</span></span><span> </span><span><span class="hljs-attr">alt</span></span><span>=</span><span><span class="hljs-string">"cart"</span></span><span> /&gt;

      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">button</span></span></span><span> </span><span><span class="hljs-attr">onClick</span></span><span>=</span><span><span class="hljs-string">{()</span></span><span> =&gt; setCount(count + 1)}&gt;
        Thêm vào giỏ
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">button</span></span></span><span>&gt;

      {count &gt; 0 &amp;&amp; (
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">span</span></span></span><span>
          </span><span><span class="hljs-attr">style</span></span><span>=</span><span><span class="hljs-string">{{</span></span><span>
            </span><span><span class="hljs-attr">position:</span></span><span> "</span><span><span class="hljs-attr">absolute</span></span><span>",
            </span><span><span class="hljs-attr">top:</span></span><span> "</span><span><span class="hljs-attr">-10px</span></span><span>",          // 🔥 </span><span><span class="hljs-attr">đè</span></span><span> </span><span><span class="hljs-attr">lên</span></span><span> </span><span><span class="hljs-attr">phía</span></span><span> </span><span><span class="hljs-attr">trên</span></span><span> </span><span><span class="hljs-attr">icon</span></span><span>
            </span><span><span class="hljs-attr">left:</span></span><span> "</span><span><span class="hljs-attr">50</span></span><span>%",           // 🔥 </span><span><span class="hljs-attr">giữa</span></span><span> </span><span><span class="hljs-attr">icon</span></span><span>
            </span><span><span class="hljs-attr">transform:</span></span><span> "</span><span><span class="hljs-attr">translateX</span></span><span>(</span><span><span class="hljs-attr">50</span></span><span>%)",
            </span><span><span class="hljs-attr">background:</span></span><span> "</span><span><span class="hljs-attr">red</span></span><span>",
            </span><span><span class="hljs-attr">color:</span></span><span> "</span><span><span class="hljs-attr">white</span></span><span>",
            </span><span><span class="hljs-attr">borderRadius:</span></span><span> "</span><span><span class="hljs-attr">50</span></span><span>%",
            </span><span><span class="hljs-attr">minWidth:</span></span><span> "</span><span><span class="hljs-attr">18px</span></span><span>",
            </span><span><span class="hljs-attr">height:</span></span><span> "</span><span><span class="hljs-attr">18px</span></span><span>",
            </span><span><span class="hljs-attr">display:</span></span><span> "</span><span><span class="hljs-attr">flex</span></span><span>",
            </span><span><span class="hljs-attr">alignItems:</span></span><span> "</span><span><span class="hljs-attr">center</span></span><span>",
            </span><span><span class="hljs-attr">justifyContent:</span></span><span> "</span><span><span class="hljs-attr">center</span></span><span>",
            </span><span><span class="hljs-attr">fontSize:</span></span><span> "</span><span><span class="hljs-attr">11px</span></span><span>",
            </span><span><span class="hljs-attr">fontWeight:</span></span><span> "</span><span><span class="hljs-attr">bold</span></span><span>",
            </span><span><span class="hljs-attr">boxShadow:</span></span><span> "</span><span><span class="hljs-attr">0</span></span><span> </span><span><span class="hljs-attr">0</span></span><span> </span><span><span class="hljs-attr">0</span></span><span> </span><span><span class="hljs-attr">2px</span></span><span> </span><span><span class="hljs-attr">white</span></span><span>", // </span><span><span class="hljs-attr">đẹp</span></span><span> </span><span><span class="hljs-attr">hơn</span></span><span>
          }}
        &gt;
          {count}
        </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">span</span></span></span><span>&gt;
      )}
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
  );
};

</span><span><span class="hljs-keyword">export</span></span><span> </span><span><span class="hljs-keyword">default</span></span><span> </span><span><span class="hljs-title class_">Popup</span></span><span>;
</span></span></code></div></div></pre>
<hr data-start="1379" data-end="1382">
<h2 data-start="1384" data-end="1411">🎯 VỊ TRÍ NÀY SẼ NHƯ SAU</h2>
<pre class="overflow-visible! px-0!" data-start="1412" data-end="1450"><div class="contain-inline-size rounded-2xl corner-superellipse/1.1 relative bg-token-sidebar-surface-primary"><div class="flex items-center text-token-text-secondary px-4 py-2 text-xs font-sans justify-between h-9 bg-token-sidebar-surface-primary select-none rounded-t-2xl corner-t-superellipse/1.1">css</div><div class="sticky top-[calc(var(--sticky-padding-top)+9*var(--spacing))]"><div class="absolute end-0 bottom-0 flex h-9 items-center pe-2"><div class="bg-token-bg-elevated-secondary text-token-text-secondary flex items-center gap-4 rounded-sm px-2 font-sans text-xs"><button class="flex gap-1 items-center select-none py-1" aria-label="Sao chép"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-sm"><use href="/cdn/assets/sprites-core-j9921kii.svg#ce3544" fill="currentColor"></use></svg>Sao chép mã</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre!"><span><span>    🔴  ← badge
